generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderType {
  B2B
  B2C
}

enum PaymentType {
  PREPAID
  COD
}

enum RateZoneType {
  INTRA
  INTER
}

enum SurchargeUnit {
  FLAT
  PERCENT
}

enum AgentAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentProfile      AgentProfile?
  ordersAsCustomer  Order[]           @relation("CustomerOrders")
  ordersCreatedBy   Order[]           @relation("CreatedByUser")
  statusEvents      OrderStatusEvent[]
  rescheduleReqs    RescheduleRequest[]
}

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  areas         Area[]
  agentProfiles AgentProfile[]
  pickupOrders  Order[] @relation("PickupZone")
  dropOrders    Order[] @relation("DropZone")

  rateCardsFrom RateCard[]
}

model Area {
  id        String   @id @default(uuid())
  name      String
  pincode   String   @unique
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  createdAt DateTime @default(now())

  @@index([zoneId])
}

// One rate card per (orderType, zoneType) pair, e.g. B2B/INTRA, B2B/INTER, B2C/INTRA, B2C/INTER.
// Admin-configurable, no hardcoded pricing anywhere in the calc engine.
model RateCard {
  id            String       @id @default(uuid())
  orderType     OrderType
  zoneType      RateZoneType
  baseCharge    Float
  perKgRate     Float
  minChargeableWeight Float  @default(0.5)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // optional: kept for future zone-pair-specific pricing; unused by the default engine
  zoneId        String?
  zone          Zone?        @relation(fields: [zoneId], references: [id])

  @@unique([orderType, zoneType])
}

model CodSurcharge {
  id         String        @id @default(uuid())
  orderType  OrderType
  unit       SurchargeUnit
  value      Float
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([orderType])
}

model AgentProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  currentZoneId String?
  currentZone  Zone?             @relation(fields: [currentZoneId], references: [id])
  currentLat   Float?
  currentLng   Float?
  availability AgentAvailability @default(AVAILABLE)
  updatedAt    DateTime          @updatedAt

  orders       Order[]
}

model Order {
  id                String      @id @default(uuid())

  customerId        String
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id])

  createdById       String
  createdBy         User        @relation("CreatedByUser", fields: [createdById], references: [id])

  pickupAddress     String
  pickupPincode     String
  pickupZoneId      String
  pickupZone        Zone        @relation("PickupZone", fields: [pickupZoneId], references: [id])

  dropAddress       String
  dropPincode       String
  dropZoneId        String
  dropZone          Zone        @relation("DropZone", fields: [dropZoneId], references: [id])

  lengthCm          Float
  breadthCm         Float
  heightCm          Float
  actualWeightKg    Float
  volumetricWeightKg Float
  chargeableWeightKg Float

  orderType         OrderType
  paymentType       PaymentType

  baseCharge        Float
  weightCharge      Float
  codSurcharge      Float
  totalCharge       Float

  status            OrderStatus @default(CREATED)

  assignedAgentId   String?
  assignedAgent     AgentProfile? @relation(fields: [assignedAgentId], references: [id])

  scheduledFor      DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  statusEvents      OrderStatusEvent[]
  notifications     Notification[]
  rescheduleReqs    RescheduleRequest[]

  @@index([status])
  @@index([pickupZoneId])
  @@index([dropZoneId])
  @@index([assignedAgentId])
}

// Immutable append-only tracking history. Never updated or deleted, only inserted.
model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  actorRole Role?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model RescheduleRequest {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  newDate       DateTime
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Notification {
  id        String              @id @default(uuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id])
  channel   NotificationChannel
  toAddress String
  subject   String?
  body      String
  status    NotificationStatus
  error     String?
  createdAt DateTime            @default(now())

  @@index([orderId])
}
