PORT=4000
NODE_ENV=development

# Local: docker-compose up -d postgres
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/delivery_tracker"

# Prisma Migrate always needs a *non-pooled* connection, even though the app
# itself can run against a pooled one. Locally there's no pooler, so this is
# just the same value as DATABASE_URL. On Vercel+Neon, DATABASE_URL becomes
# Neon's pooled "-pooler" host and DIRECT_URL becomes its direct host -
# Neon's dashboard gives you both.
DIRECT_URL="postgresql://tracker:tracker@localhost:5432/delivery_tracker"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS origin allowed to call the API. "*" is fine for local/single-service deploys.
WEB_ORIGIN="*"

# Optional: leave unset to skip real email sends (notifications are still
# logged to the Notification table with status SKIPPED). Any SMTP provider
# works - e.g. Gmail app password, Mailtrap, Brevo (Sendinblue) free tier.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Delivery Tracker <no-reply@delivery-tracker.local>"

# Optional: Twilio trial account for SMS. Leave unset to skip real sends
# (still logged to the Notification table with status SKIPPED).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
